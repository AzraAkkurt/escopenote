# Server
PORT=3000
HOST=127.0.0.1

# Gemini (optional — without key, mock responses are used)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Postgres (B2). Requires Docker: `npm run db:up` (also runs automatically before `npm run dev`).
# Without DATABASE_URL, auth/billing are disabled.
DATABASE_URL=postgres://escopenote:escopenote@127.0.0.1:5433/escopenote_brain
DAILY_USAGE_LIMIT=100
BILLING_MIN_CHARGE=1
BILLING_MARGIN_MULTIPLIER=1

# Legacy: only used when DATABASE_URL is empty
ESCOPENOTE_API_KEY=

# CORS (comma-separated origins, or * for dev)
CORS_ORIGINS=*
